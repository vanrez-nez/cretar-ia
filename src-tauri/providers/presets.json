    {
      "id": "openrouter",
      "name": "OpenRouter",
      "kind": "openrouter",
      "config": {
        "base_url": "https://openrouter.ai/api/v1",
        "auth": {
          "type": "bearer_api_key",
          "api_key": ""
        },
        "endpoints": {
          "models": "/models",
          "chat_completions": "/chat/completions",
          "audio_transcriptions": "/audio/transcriptions"
        },
        "model_fetch": {
          "strategy": "openrouter_models",
          "dynamic": true,
          "query_by_role": {
            "stt": {
              "output_modalities": "all"
            },
            "formatting": {
              "output_modalities": "text"
            }
          }
        },
        "metrics": {
          "strategy": "response_usage",
          "supports_cost": true,
          "supports_tokens": true
        },
        "capabilities": {
          "roles": [
            "stt",
            "formatting"
          ],
          "openai_compatible": true,
          "local": false
        }
      },
