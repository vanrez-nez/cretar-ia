              "strategy": {
                "const": "openrouter_models"
              },
              "dynamic": {
                "type": "boolean"
              },
              "query_by_role": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stt": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
