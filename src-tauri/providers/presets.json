              "supports_tokens"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "response_usage",
                  "generation_stats"
                ]
              },
              "supports_cost": {
                "type": "boolean"
              },
              "supports_tokens": {
                "type": "boolean"
              }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roles",
              "openai_compatible",
              "local"
