{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cretar IA",
  "version": "0.1.0",
  "identifier": "com.cretaria.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "features": ["tray", "settings-ui"]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$HOME/**"]
      },
      "capabilities": [
        {
          "identifier": "settings-ui",
          "description": "Runtime access for the settings window",
          "windows": ["settings"],
          "permissions": ["core:default", "log:default", "autostart:default", "dialog:allow-open", "dialog:allow-save", "dialog:allow-message", "sql:default", "sql:allow-execute", "settings-ui-commands"]
        }
      ]
    },
    "windows": [
      {
        "label": "settings",
        "title": "Cretar IA Settings",
        "width": 880,
        "height": 490,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:cretar-ia.db"]
    }
  }
}
